<button class='button button-role-{{role}}' type={{type}}>
  {{#if href}}
  <a class='button-a' href={{href}}>
    {{#if icon-source}}
    {{{Icon source=icon-source}}}
    {{/if}}
    {{text}}
  </a>
  {{else}}
  {{#if icon-source}}
  {{{Icon source=icon-source}}}
  {{/if}}
  {{text}}
  {{/if}}
</button>
