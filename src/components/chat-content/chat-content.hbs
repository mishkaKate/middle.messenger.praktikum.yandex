<div class="chat-content">
    <div class="chat-content__header">
        {{> avatar size="m"}}
        <h3>{{title}}</h3>
    </div>
    <div class="chat-content__body">
        <div class="chat-content__messege"></div>
        <div class="chat-content__messege_my"></div>
    </div>
    <div class="chat-content__footer">
        <button class="chat-content__clip">{{> icon icon-source="clip"}}</button>
        <input class="chat-content__input" type="text" placeholder="Сообщение">
        <button class="chat-content__send">{{> icon icon-source="send"}}</button>
    </div>
</div>
