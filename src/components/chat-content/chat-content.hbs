<div class="chat-content">
    <div class="chat-content-header">
        {{> avatar size="m"}}
        <h3>{{title}}</h3>
    </div>
    <div class="chat-content-body">
        <div class="chat-content-messege"></div>
        <div class="chat-content-messege-type-my"></div>
    </div>
    <div class="chat-content-footer">
        <button class="chat-content-button-clip">{{> icon icon-source="clip"}}</button>
        <input class="chat-content-input" type="text" placeholder="Сообщение">
        <button class="chat-content-button-send">{{> icon icon-source="send"}}</button>
    </div>
</div>
