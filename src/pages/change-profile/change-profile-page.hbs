<main class='form-page'>
  <form class='form'>
    <h2 class='form-header'>Изменить данные профиля</h2>
    {{{InputImage name='avatar' id='avatar' label='Изменить аватар'}}}
    {{{Input
    id='change-profile-emeil'
    name='email'
    placeholder='Почта'
    label='почта'
    type='email'
    validationRule='^[A-Za-z0-9_-]+@[A-Za-z]+\.[A-Za-z0-9_-]+$'
    }}}
    {{{Input
    id='change-profile-login'
    name='login'
    placeholder='Логин'
    label='логин'
    type='text'
    validationRule='^(?=.*[A-Za-z_-])[A-Za-z0-9_-]{3,20}$'
    }}}
    {{{Input
    id='change-profile-name'
    name='first_name'
    placeholder='Имя'
    label='имя'
    type='text'
    validationRule='^[A-ZА-ЯЁ][a-zа-яё-]*$'
    }}}
    {{{Input
    id='change-profile-surname'
    name='second_name'
    placeholder='Фамилия'
    label='фамилия'
    type='text'
    validationRule='^[A-ZА-ЯЁ][a-zа-яё-]*$'
    }}}
    {{{Input
    id='change-profile-chatname'
    name='display_name'
    placeholder='Фамилия'
    label='фамилия'
    type='text'
    validationRule='^[A-ZА-ЯЁ][a-zа-яё-]*$'
    }}}
    {{{Input
    id='change-profile-phone'
    name='phone'
    placeholder='Телефон'
    label='телефон'
    type='tel'
    validationRule='^(?=.{10,15}$)\+?[0-9]+$'
    }}}
    <div class='form-footer'>
      {{{Button type='submit' role='main' text='Сохранить'}}}
    </div>
  </form>
</main>
