<div class="form-page">
    <form class="form">
        <h2 class="form-header">Изменить данные профиля</h2>
        {{> input placeholder="Почта" label="почта" type="email"}}
        {{> input placeholder="Логин" label="логин" type="text"}}
        {{> input placeholder="Имя" label="имя" type="text"}}
        {{> input placeholder="Фамилия" label="фамилия" type="text"}}
        {{> input placeholder="Телефон" label="телефон" type="tel"}}
        <div class="form-footer">
            {{> button role="main" text="Сохранить" href="/profile"}}
        </div>
    </form>
</div>
