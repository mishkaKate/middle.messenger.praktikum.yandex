<main class='form-page'>
  <form class='form'>
    <h2 class='form-header'>Регистрация</h2>
    {{{Input
    ref='email'
    id='registration-form-email'
    name='email'
    placeholder='Почта'
    label='почта'
    type='email'
    validationRule='^[A-Za-z0-9_-]+@[A-Za-z]+\.[A-Za-z0-9_-]+$'
    }}}
    {{{Input
    id='registration-form-login'
    name='login'
    placeholder='Логин'
    label='логин'
    type='text'
    validationRule='^(?=.*[A-Za-z_-])[A-Za-z0-9_-]{3,20}$'
    }}}
    {{{Input
    id='registration-form-name'
    name='first_name'
    placeholder='Имя'
    label='имя'
    type='text'
    validationRule='^[A-ZA-ЯЁ][a-za-яё-]*$'
    }}}
    {{{Input
    id='registration-form-surname'
    name='second_name'
    placeholder='Фамилия'
    label='фамилия'
    type='text'
    validationRule='^[A-ZA-ЯЁ][a-za-яё-]*$'
    }}}
    {{{Input
    id='registration-form-phone'
    name='phone'
    placeholder='Телефон'
    label='телефон'
    type='tel'
    validationRule='^(?=.{10,15}$)\+?[0-9]+$'
    }}}
    {{{Input
    id='registration-form-password'
    name='password'
    placeholder='Пароль'
    label='пароль'
    type='password'
    validationRule='^(?=.*[A-Z])(?=.*\d)[A-Za-z0-9_-]{8,40}$'
    }}}
    {{{Input
    id='registration-form-more'
    name='password-more'
    placeholder='Пароль (еще раз)'
    label='пароль (еще раз)'
    type='password'
    validationRule='^(?=.*[A-Z])(?=.*\d)[A-Za-z0-9_-]{8,40}$'
    }}}
    <div class='form-footer'>
      {{{Button type='submit' role='main' text='Зарегистрироваться'}}}
      {{{Button text='Войти' href='/'}}}
    </div>
  </form>
</main>
