<div class="form-page">
    <form class="form">
        <h2 class="form__header">Регистрация</h2>
        {{> input placeholder="Почта" label="почта" type="email"}}
        {{> input placeholder="Логин" label="логин" type="text"}}
        {{> input placeholder="Имя" label="имя" type="text"}}
        {{> input placeholder="Фамилия" label="фамилия" type="text"}}
        {{> input placeholder="Телефон" label="телефон" type="tel"}}
        {{> input placeholder="Пароль" label="пароль" type="password"}}
         {{> input placeholder="Пароль (еще раз)" label="пароль (еще раз)" type="password"}}
        <div class="form__footer">
            {{> button role="main" text="Зарегистрироваться" href="/main"}}
            {{> button text="Войти" href="/"}}
        </div>
    </form>
</div>