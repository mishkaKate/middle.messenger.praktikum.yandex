<main class="form-page">
    <form class="form">
        <h2 class="form-header">Регистрация</h2>
        {{> input id="registration-form-email" name="email" placeholder="Почта" label="почта" type="email"}}
        {{> input id="registration-form-login" name="login" placeholder="Логин" label="логин" type="text"}}
        {{> input id="registration-form-name" name="first_name" placeholder="Имя" label="имя" type="text"}}
        {{> input id="registration-form-surname" name="second_name"  placeholder="Фамилия" label="фамилия" type="text"}}
        {{> input id="registration-form-phone" name="phone" placeholder="Телефон" label="телефон" type="tel"}}
        {{> input id="registration-form-password" name="password" placeholder="Пароль" label="пароль" type="password"}}
        {{> input id="registration-form-more" name="password-more" placeholder="Пароль (еще раз)" label="пароль (еще раз)" type="password"}}
        <div class="form-footer">
            {{> button role="main" text="Зарегистрироваться" href="/main"}}
            {{> button text="Войти" href="/"}}
        </div>
    </form>
</main>
