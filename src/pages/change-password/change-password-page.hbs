<main class="form-page">
    <form class="form">
        <h2 class="form-header">Изменить пароль</h2>
        {{> input id="change-password-password" name="password"  placeholder="Пароль" label="пароль" type="password"}}
        {{> input id="change-password-new-password" name="new_password"  placeholder="Новый пароль" label="пароль" type="password"}}
        {{> input id="change-password-new-password-more" name="new_password_more"  placeholder="Новый пароль (еще раз)" label="пароль (еще раз)" type="password"}}
        <div class="form-footer">
            {{> button role="main" text="Сохранить" href="/profile"}}
        </div>
    </form>
</main>
