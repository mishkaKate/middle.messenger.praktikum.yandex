<main class='form-page'>
    <form class='form'>
        <h2 class='form-header'>Изменить пароль</h2>
        {{{Input
        id='change-password-old-password'
        name='old_password'
        placeholder='Пароль'
        label='пароль'
        type='password'
        validationRule='^(?=.*[A-Z])(?=.*\d)[A-Za-z0-9_-]{8,40}$'
        }}}
        {{{Input
        id='change-password-new-password'
        name='new_password'
        placeholder='Новый пароль'
        label='пароль'
        type='password'
        validationRule='^(?=.*[A-Z])(?=.*\d)[A-Za-z0-9_-]{8,40}$'
        }}}
        {{{Input
        id='change-password-new-password-more'
        name='new_password_more'
        placeholder='Новый пароль (еще раз)'
        label='пароль (еще раз)'
        type='password'
        validationRule='^(?=.*[A-Z])(?=.*\d)[A-Za-z0-9_-]{8,40}$'
        }}}
        <div class='form-footer'>
            {{{Button type='submit' role='main' text='Сохранить'}}}
        </div>
    </form>
</main>
