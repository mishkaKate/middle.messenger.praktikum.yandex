<main class='profile-page'>
  {{{Button role='back' icon-source='back' type='button' id='chats-button'}}}
  <div class='profile-page-content'>
    <div class='profile'>
      {{{InputImage name='avatar' id='avatar' label='Изменить аватар' src=avatar}}}
      <h1 class='profile-title'>{{title}}</h1>
      <ul class='profile-list'>
        <li class='profile-list-item'>
          <span>Имя</span>
          <span>{{name}}</span>
        </li>
        <li class='profile-list-item'>
          <span>Фамилия</span>
          <span>{{surname}}</span>
        </li>
        <li class='profile-list-item'>
          <span>Телефон</span>
          <span>{{phone}}</span>
        </li>
        <li class='profile-list-item'>
          <span>Почта</span>
          <span>{{email}}</span>
        </li>
      </ul>
      <footer class='profile-page-footer'>
        {{{Button text='Изменить профиль' type='button' id='profile-change'}}}
        {{{Button text='Изменить пароль' type='button' id='password-change'}}}
        {{{Button text='Выйти' role='attantion' type='button' id='logout-button'}}}
      </footer>
    </div>
  </div>
</main>
