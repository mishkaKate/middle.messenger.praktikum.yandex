<div class="profile-page">
    {{> button href="/main" role="back" icon-source="back"}}
    <div class="profile-page__content">
        <div class="profile">
        {{> avatar size="l"}}
        <h1 class="profile__title">{{title}}</h1>
        <ul class="profile__list">
            <li class="profile-list__item">
                <span>Имя</span> <span>{{name}}</span>
            </li>
            <li class="profile-list__item">
                <span>Фамилия</span> <span>{{surname}}</span>
            </li>
            <li class="profile-list__item">
                <span>Телефон</span> <span>{{phone}}</span>
            </li>
            <li class="profile-list__item">
                <span>Почта</span> <span>{{email}}</span>
            </li>
        </ul>
         <footer class="profile-page__footer">
            <a class="profile__a" href="/profile-change">Изменить профиль</a>
            <a class="profile__a" href="/password-change">Изменить пароль</a>
        </footer> 
        </div>    
    </div>
</div>
