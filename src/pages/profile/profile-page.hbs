<main class='profile-page'>
  {{{Button href='/main' role='back' icon-source='back' type='button'}}}
  <div class='profile-page-content'>
    <div class='profile'>
      {{{Avatar size='l'}}}
      <h1 class='profile-title'>{{title}}</h1>
      <ul class='profile-list'>
        <li class='profile-list-item'>
          <span>Имя</span>
          <span>{{name}}</span>
        </li>
        <li class='profile-list-item'>
          <span>Фамилия</span>
          <span>{{surname}}</span>
        </li>
        <li class='profile-list-item'>
          <span>Телефон</span>
          <span>{{phone}}</span>
        </li>
        <li class='profile-list-item'>
          <span>Почта</span>
          <span>{{email}}</span>
        </li>
      </ul>
      <footer class='profile-page-footer'>
        {{{Link href='/profile-change' text='Изменить профиль'}}}
        {{{Link href='/password-change' text='Изменить пароль'}}}
      </footer>
    </div>
  </div>
</main>
